{
  "name": "bgd-ink-studio",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "vite build",
    "check:assets": "node scripts/check-3d-assets.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "npm run check:environment && npm run typecheck && npm run lint && npm run check:brand && npm run check:boundaries && npm run check:assets && npm run test:unit && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "check:environment": "node scripts/check-environment.mjs",
    "check:brand": "node scripts/check-brand-boundaries.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.96.1",
    "@react-three/fiber": "8.15.14",
    "gsap": "^3.14.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.160.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
