# Optional public deployment URL used for canonical links, social images, robots.txt, and sitemap.xml.
# Builds stay non-indexable when this value is omitted.
VITE_PUBLIC_SITE_URL=https://your-domain.example

# Keep this false for local development and preview deployments.
# Set it to true only for the one production deployment that should be indexed.
VITE_INDEXABLE_BUILD=false
